  "services": [
    {
      "identifier": "set_fan",
      "name": "设置通风扇",
      "description": "控制通风扇开关",
      "input_params": [
        {
          "identifier": "status",
          "name": "开关状态",
          "data_type": "bool",
          "description": "true=开启，false=关闭"
        }
      ]
    },
    {
      "identifier": "set_light",
      "name": "设置补光灯",
      "description": "控制补光灯开关和亮度",
      "input_params": [
        {
          "identifier": "status",
          "name": "开关状态",
          "data_type": "bool",
          "description": "true=开启，false=关闭"
        },
        {
          "identifier": "brightness",
          "name": "亮度",
          "data_type": "int",
          "description": "亮度百分比，范围10~100"
        }
      ]
    },
    {
      "identifier": "set_pump",
      "name": "设置灌溉水泵",
      "description": "控制灌溉水泵开关",
      "input_params": [
        {
          "identifier": "status",
          "name": "开关状态",
          "data_type": "bool",
          "description": "true=开启，false=关闭"
        }
      ]
    },
    {
      "identifier": "set_heater",
      "name": "设置加热器",
      "description": "控制加热器开关",
      "input_params": [
        {
          "identifier": "status",
          "name": "开关状态",
          "data_type": "bool",
          "description": "true=开启，false=关闭"
        }
      ]
    },
    {
      "identifier": "set_humidifier",
      "name": "设置加湿器",
      "description": "控制加湿器开关",
      "input_params": [
        {
          "identifier": "status",
          "name": "开关状态",
          "data_type": "bool",
          "description": "true=开启，false=关闭"
        }
      ]
    },
    {
      "identifier": "set_vent",
      "name": "设置通风窗",
      "description": "控制通风窗开合程度",
      "input_params": [
        {
          "identifier": "open_percent",
          "name": "开启百分比",
          "data_type": "int",
          "description": "开启程度，范围0~100"
        }
      ]
    }
  ],
  "events": [
    {
      "identifier": "high_temp_alert",
      "name": "高温告警",
      "type": "warning",
      "description": "空气温度超过设定阈值"
    },
    {
      "identifier": "low_temp_alert",
      "name": "低温告警",
      "type": "warning",
      "description": "空气温度低于设定阈值"
    },
    {
      "identifier": "device_offline_alert",
      "name": "设备离线告警",
      "type": "error",
      "description": "设备与平台断开连接"
    },
    {
      "identifier": "high_humidity_alert",
      "name": "高湿告警",
      "type": "warning",
      "description": "空气湿度超过设定阈值"
